<Window x:Class="IconSwapperGui.UI.Windows.ImageCropEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:images="clr-namespace:IconSwapperGui.Core.Models.Images;assembly=IconSwapperGui.Core"
        Title="Crop Image"
        Width="820"
        Height="560"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Crop and Fit" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding FileName}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <Grid>
                    <Border x:Name="CropPreviewSurface"
                            Width="320"
                            Height="320"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#20A0A7B3"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            ClipToBounds="True"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="CropPreviewSurface_MouseLeftButtonDown"
                            MouseLeftButtonUp="CropPreviewSurface_MouseLeftButtonUp"
                            MouseMove="CropPreviewSurface_MouseMove"
                            MouseWheel="CropPreviewSurface_MouseWheel"
                            AutomationProperties.Name="Drag crop preview to reposition image and scroll to zoom">
                        <Grid>
                            <Image Source="{Binding PreviewImage}"
                                   Stretch="None"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                            </Image>
                            <Border BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2"
                                    Background="Transparent" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Crop Mode" Style="{StaticResource SectionTitleStyle}" />
                    <ComboBox SelectedValue="{Binding CropMode, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Margin="0,8,0,16">
                        <ComboBoxItem Content="Center crop" Tag="{x:Static images:ImageCropMode.CenterCrop}" />
                        <ComboBoxItem Content="Fit with padding" Tag="{x:Static images:ImageCropMode.FitWithPadding}" />
                        <ComboBoxItem Content="Fill and crop" Tag="{x:Static images:ImageCropMode.FillAndCrop}" />
                    </ComboBox>

                    <TextBlock Text="Zoom" Style="{StaticResource MutedTextStyle}" />
                    <Slider Minimum="1" Maximum="4" TickFrequency="0.1"
                            Value="{Binding Zoom, Mode=TwoWay}"
                            Style="{StaticResource ModernSliderStyle}" />

                    <TextBlock Text="Horizontal Focus" Style="{StaticResource MutedTextStyle}" Margin="0,16,0,0" />
                    <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                            Value="{Binding FocusX, Mode=TwoWay}"
                            Style="{StaticResource ModernSliderStyle}" />

                    <TextBlock Text="Vertical Focus" Style="{StaticResource MutedTextStyle}" Margin="0,16,0,0" />
                    <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                            Value="{Binding FocusY, Mode=TwoWay}"
                            Style="{StaticResource ModernSliderStyle}" />

                    <Button Content="Center Image"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,8"
                            Margin="0,14,0,0"
                            AutomationProperties.Name="Center crop image"
                            Command="{Binding CenterFocusCommand}" />

                    <CheckBox Content="Transparent padding"
                              IsChecked="{Binding UseTransparentPadding, Mode=TwoWay}"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Preview shows the square icon area. Focus controls affect crop positioning during conversion."
                       Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="18,10"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" />
                <Button Content="Apply"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="18,10"
                        Command="{Binding ApplyCommand}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
