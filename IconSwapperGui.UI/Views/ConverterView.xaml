<UserControl x:Class="IconSwapperGui.UI.Views.ConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:IconSwapperGui.UI.Converters"
             xmlns:images="clr-namespace:IconSwapperGui.Core.Models.Images;assembly=IconSwapperGui.Core"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:IconPathToImageConverter x:Key="IconPathToImageConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}"
          AllowDrop="True"
          DragOver="Converter_DragOver"
          Drop="Converter_Drop"
          Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Converter" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Build a queue, tune crop behavior, then export multi-size Windows icon files."
                           Style="{StaticResource MutedTextStyle}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Add Images"
                        Padding="14,10"
                        Margin="0,0,8,0"
                        Command="{Binding AddConverterImagesCommand}" />
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Add Folder"
                        Padding="14,10"
                        Margin="0,0,8,0"
                        Command="{Binding AddConverterLocationCommand}" />
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Refresh"
                        Padding="14,10"
                        Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel>
                    <TextBlock Text="Import" Style="{StaticResource SectionTitleStyle}" />
                    <Border Background="{DynamicResource AccentLightBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,12,0,20">
                        <StackPanel>
                            <TextBlock Text="Drop PNG/JPG files anywhere on this page." 
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Folders are watched automatically; individual files stay in the queue until removed."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Default Crop" Style="{StaticResource SectionTitleStyle}" />
                    <ComboBox SelectedValue="{Binding SelectedCropMode, Mode=TwoWay}"
                              SelectedValuePath="Tag"
                              Style="{StaticResource ModernComboBoxStyle}"
                              Margin="0,10,0,20">
                        <ComboBoxItem Content="Center crop" Tag="{x:Static images:ImageCropMode.CenterCrop}" />
                        <ComboBoxItem Content="Fit with transparent padding" Tag="{x:Static images:ImageCropMode.FitWithPadding}" />
                        <ComboBoxItem Content="Fill and crop" Tag="{x:Static images:ImageCropMode.FillAndCrop}" />
                    </ComboBox>

                    <TextBlock Text="Output" Style="{StaticResource SectionTitleStyle}" />
                    <CheckBox IsChecked="{Binding UseSourceFolderForConversion}"
                              Content="Save beside each source image"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Margin="0,10,0,10" />

                    <Border Background="{DynamicResource HoverBrush}"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,12">
                        <TextBlock Text="{Binding ConversionOutputFolder}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding ConversionOutputFolder}" />
                    </Border>

                    <UniformGrid Columns="2">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Choose"
                                Padding="12,9"
                                Margin="0,0,6,0"
                                Command="{Binding ChooseConversionOutputFolderCommand}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Use Source"
                                Padding="12,9"
                                Margin="6,0,0,0"
                                Command="{Binding ClearConversionOutputFolderCommand}" />
                    </UniformGrid>

                    <Border Style="{StaticResource EditorDividerStyle}" Margin="0,20,0,18" />

                    <CheckBox Content="Delete source images after conversion"
                              IsChecked="{Binding CanDeleteImagesAfterConversion}"
                              Style="{StaticResource ModernCheckBoxStyle}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,18,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Conversion Queue" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Select an image to edit crop settings or remove it from this batch."
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Edit Crop"
                                    Padding="12,8"
                                    Margin="0,0,8,0"
                                    Command="{Binding EditImageCropCommand}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Remove"
                                    Padding="12,8"
                                    Command="{Binding RemoveConverterImageCommand}"
                                    CommandParameter="{Binding SelectedImage}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding FilteredIcons}"
                                 SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="12">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItemContainerStyle}">
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="78">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="58"
                                                Height="58"
                                                Background="{DynamicResource AppBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Margin="0,0,12,0">
                                            <Image Source="{Binding Path, Converter={StaticResource IconPathToImageConverter}}"
                                                   Width="42"
                                                   Height="42"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="Ready"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="14,0,4,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding FilteredIcons.Count, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="No images queued" Style="{StaticResource EmptyStateTitleStyle}" />
                            <TextBlock Text="Drop PNG/JPG files here, or add a folder to watch for new images."
                                       Style="{StaticResource EmptyStateBodyStyle}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Content="Add Images"
                                        Padding="16,10"
                                        Margin="0,0,8,0"
                                        Command="{Binding AddConverterImagesCommand}" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Add Folder"
                                        Padding="16,10"
                                        Command="{Binding AddConverterLocationCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="16"
                Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Multi-size ICO output: 16, 32, 48, 64, 128, and 256 px"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontWeight="SemiBold" />
                    <ProgressBar Margin="0,10,0,0"
                                 Style="{StaticResource ModernProgressBarStyle}"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ConversionProgress}"
                                 Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Convert Queue"
                        Padding="24,12"
                        MinWidth="150"
                        Command="{Binding ConvertIconCommand}"
                        IsEnabled="{Binding CanConvertImages}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
