<UserControl x:Class="IconSwapperGui.UI.Views.FolderThemeDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/SharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Folder Theme Designer" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Design matching folder icons with color, badge, and label variants." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Design" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Text="Folder style" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding FolderStyles}"
                              SelectedItem="{Binding FolderStyleName}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              AutomationProperties.Name="Folder visual style" />

                    <TextBlock Text="Tab style" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding TabStyles}"
                              SelectedItem="{Binding TabStyleName}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              AutomationProperties.Name="Folder tab style" />

                    <TextBlock Text="Folder color" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding FolderColors}"
                              SelectedItem="{Binding FolderColorName}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              AutomationProperties.Name="Folder color" />

                    <TextBlock Text="Badge color" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding AccentColors}"
                              SelectedItem="{Binding AccentColorName}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              AutomationProperties.Name="Accent color" />

                    <CheckBox Content="Show document insert"
                              IsChecked="{Binding ShowDocument}"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Margin="0,14,0,6"
                              AutomationProperties.Name="Show document insert" />

                    <CheckBox Content="Show badge"
                              IsChecked="{Binding IsBadgeEnabled}"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Margin="0,14,0,6"
                              AutomationProperties.Name="Show badge on folder icon" />

                    <TextBlock Text="Badge" Style="{StaticResource MutedTextStyle}" Margin="0,8,0,6" />
                    <TextBox Text="{Binding Badge, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" MaxLength="2" />

                    <TextBlock Text="Label" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,6" />
                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" MaxLength="10" />

                    <TextBlock Text="Label placement" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,6" />
                    <ComboBox ItemsSource="{Binding LabelPlacements}"
                              SelectedItem="{Binding LabelPlacementName}"
                              Style="{StaticResource ModernComboBoxStyle}"
                              AutomationProperties.Name="Folder label placement" />

                    <DockPanel Margin="0,14,0,6">
                        <TextBlock Text="Label size" Style="{StaticResource MutedTextStyle}" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding LabelFontSize, StringFormat={}{0:0}px}"
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <Slider Minimum="12"
                            Maximum="48"
                            TickFrequency="2"
                            Value="{Binding LabelFontSize, Mode=TwoWay}"
                            Style="{StaticResource ModernSliderStyle}"
                            AutomationProperties.Name="Folder label font size" />

                    <DockPanel Margin="0,14,0,6">
                        <TextBlock Text="Depth" Style="{StaticResource MutedTextStyle}" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding FolderDepth, StringFormat={}{0:P0}}"
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <Slider Minimum="0"
                            Maximum="1"
                            TickFrequency="0.05"
                            Value="{Binding FolderDepth, Mode=TwoWay}"
                            Style="{StaticResource ModernSliderStyle}"
                            AutomationProperties.Name="Folder depth" />

                    <DockPanel Margin="0,14,0,6">
                        <TextBlock Text="Corner softness" Style="{StaticResource MutedTextStyle}" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding CornerSoftness, StringFormat={}{0:0}px}"
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <Slider Minimum="4"
                            Maximum="22"
                            TickFrequency="1"
                            Value="{Binding CornerSoftness, Mode=TwoWay}"
                            Style="{StaticResource ModernSliderStyle}"
                            AutomationProperties.Name="Folder corner softness" />

                    <TextBlock Text="File name" Style="{StaticResource MutedTextStyle}" Margin="0,14,0,6" />
                    <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBoxStyle}" />

                    <Border Style="{StaticResource EditorDividerStyle}" Margin="0,18,0,18" />

                    <TextBlock Text="Output" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding OutputPath}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,12" />
                    <Button Content="Choose Folder" Style="{StaticResource SecondaryButtonStyle}" Padding="14,8" Command="{Binding ChooseOutputFolderCommand}" />
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="32">
                        <Image Source="{Binding PreviewImage}" Width="320" Height="320" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Row="1" Text="Preview updates as you edit. Export creates a Windows-ready multi-size ICO and PNG source." Style="{StaticResource MutedTextStyle}" Margin="0,16,0,0" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Create reusable themed folder icons for projects, games, archives, workspaces, and collections." Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Export Folder Icon" Style="{StaticResource PrimaryButtonStyle}" Padding="24,12" Command="{Binding ExportCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
